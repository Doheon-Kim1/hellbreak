{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "src/game/camera.ts",
    "src/game/movement.ts",
    "src/game/playground.ts"
  ],
  "exclude": ["node_modules", "src/**/*.test.ts"]
}